{
  "name": "@tokennotincluded/opencode-lmm-auth",
  "version": "0.1.3",
  "description": "LMM OAuth provider plugin for OpenCode and Magpie",
  "type": "module",
  "main": "./dist/index.js",
  "license": "AGPL-3.0-only",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "lmm",
    "oauth",
    "provider"
  ],
  "magpie": {
    "icon": "https://raw.githubusercontent.com/TokenNotIncluded/opencode-lmm-auth/main/assets/icon.svg",
    "maxConcurrency": 4
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/opencode-v2.js"
  },
  "files": [
    "assets",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "dist",
    "scripts",
    "server.js"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.34"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@opencode/plugin": "2.1.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test:host": "node scripts/test-host.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:integration": "node scripts/test-integration.mjs",
    "test:v2": "node scripts/test-opencode-v2.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenNotIncluded/opencode-lmm-auth.git"
  },
  "homepage": "https://github.com/TokenNotIncluded/opencode-lmm-auth#readme"
}
